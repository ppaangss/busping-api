{
  "uid": "loadtest-overview",
  "title": "Loadtest Overview",
  "schemaVersion": 39,
  "refresh": "1s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "API p95 (uri별)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "처리량 (RPS, uri별)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "에러율 (5xx)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\",uri!~\"/actuator.*\"}[1m])) / sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "5xx 비율"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "톰캣 스레드",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "tomcat_threads_busy_threads",
          "legendFormat": "busy"
        },
        {
          "expr": "tomcat_threads_current_threads",
          "legendFormat": "current"
        },
        {
          "expr": "tomcat_threads_config_max_threads",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션풀 (HikariCP)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        },
        {
          "expr": "hikaricp_connections_max",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TAGO 호출량",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_client_requests_seconds_count[1m]))",
          "legendFormat": "외부 호출/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TAGO 지연 p95",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_client_requests_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "app"
        },
        {
          "expr": "system_cpu_usage",
          "legendFormat": "system"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 힙",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "클라이언트 체감 지연",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "k6_http_req_duration_p95{scenario=\"probe_raw\"}",
          "legendFormat": "정류장 검색 p95 (끝까지 기다림)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "k6_http_req_duration_max{scenario=\"probe_raw\"}",
          "legendFormat": "정류장 검색 max",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "k6_http_req_duration_p95{scenario=\"ping_storm\"}",
          "legendFormat": "핑 p95",
          "refId": "C"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "정류장 검색 API 성공률",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "(sum(rate(k6_http_reqs_total{scenario=\"probe_user\",expected_response=\"true\"}[15s])) or vector(0)) / sum(rate(k6_http_reqs_total{scenario=\"probe_user\"}[15s]))",
          "legendFormat": "정류장 검색 API 성공률",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "스레드풀 대기 시간 (체감 - 서버 처리)",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "clamp_min(k6_http_req_duration_p95{scenario=\"probe_raw\"} - scalar((histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/stations/nearby\"}[15s]))) or vector(0))), 0)",
          "legendFormat": "정류장 검색 - 줄 선 시간 p95 (추정)",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "알람 워커·큐 (02 계기판)",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "executor_queued_tasks{name=\"alarmExecutor\"}",
          "legendFormat": "큐 깊이 (한계 256)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "executor_active_threads{name=\"alarmExecutor\"}",
          "legendFormat": "활성 워커",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "executor_pool_max_threads{name=\"alarmExecutor\"}",
          "legendFormat": "워커 한계 (20)",
          "refId": "C"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "알람 폐기·스킵 (건/분)",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "rate(alarm_queue_discarded_total[1m])*60",
          "legendFormat": "큐 포화 폐기 (DiscardOldest)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "rate(alarm_stale_skipped_total[1m])*60",
          "legendFormat": "TTL 30초 초과 스킵",
          "refId": "B"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "요청 수 vs TAGO 호출 수 (03 계기판)",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/stations/{stationId}/realtime\"}[1m])) + sum(rate(http_server_requests_seconds_count{uri=\"/api/devices/me/location\"}[1m]))",
          "legendFormat": "도착정보 수요/s (조회+알람)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(http_client_requests_seconds_count[1m]))",
          "legendFormat": "TAGO 실제 호출/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/stations/{stationId}/realtime\"}[1m]))",
          "legendFormat": "조회 요청/s (참고)",
          "refId": "C"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "조회 체감 응답시간 (03)",
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "k6_http_req_duration_med{scenario=\"lookup\"}",
          "legendFormat": "조회 p50 (캐시의 정직한 지표)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "k6_http_req_duration_p95{scenario=\"lookup\"}",
          "legendFormat": "조회 p95 (적중률 95%를 넘어야 움직임)",
          "refId": "B"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "떨어뜨린 요청 (측정 유효성, 0이어야 비교 가능)",
      "gridPos": {
        "x": 12,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum by (scenario) (rate(k6_dropped_iterations_total[1m]))",
          "legendFormat": "{{scenario}} 떨어뜨림/s",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "캐시 적중률 (03)",
      "gridPos": {
        "x": 0,
        "y": 96,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(arrival_cache_requests_total{result=\"hit\"}[1m])) / sum(rate(arrival_cache_requests_total[1m]))",
          "legendFormat": "적중률 (시드 분포 가정과 함께 보고)",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "캐시 적중/미스 (건/s, 03)",
      "gridPos": {
        "x": 12,
        "y": 96,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(arrival_cache_requests_total{result=\"hit\"}[1m]))",
          "legendFormat": "적중/s (캐시가 받아낸 양)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(arrival_cache_requests_total{result=\"miss\"}[1m]))",
          "legendFormat": "미스/s (TAGO로 간 양)",
          "refId": "B"
        }
      ],
      "id": 10
    }
  ]
}