# BusPing 환경변수 템플릿
# 실제 값은 .env로 복사해서 채운다 - .env는 절대 커밋하지 않는다
# 스프링이 .env를 자동으로 읽지는 않는다: IntelliJ 실행 설정, export, docker --env-file 등으로 주입

# ─── dev 프로파일 ───
# 필요한 환경변수 없음 - TAGO·FCM 전부 fake, DB/Redis는 localhost 기본값

# ─── staging 프로파일 (실 TAGO + 실 FCM) ───
# 공공데이터포털 TAGO 인증키 (버스 도착정보 조회)
TAGO_API_KEY=

# Firebase 서비스 계정 키 파일 경로 (실 푸시 발송용, 없으면 발송만 비활성)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# ─── prod 프로파일 (전부 필수 - 기본값 없음, 누락 시 부팅 실패) ───
DB_URL=jdbc:mysql://HOST:3306/station_alarm?serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
# TAGO_API_KEY, FIREBASE_CREDENTIALS_PATH도 필수 (위 참고)
